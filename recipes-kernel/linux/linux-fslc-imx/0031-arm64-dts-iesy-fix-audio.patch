From f4efbee30731d6e547b5824a866fed9c117f458f Mon Sep 17 00:00:00 2001
From: Dominik Poggel <pog@iesy.com>
Date: Thu, 31 Oct 2024 13:39:52 +0100
Subject: [PATCH 31/31] arm64: dts: iesy: fix audio

Signed-off-by: Dominik Poggel <pog@iesy.com>
---
 arch/arm64/boot/dts/iesy/iesy-imx8mm-eva-mi-v1.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/iesy/iesy-imx8mm-eva-mi-v1.dts b/arch/arm64/boot/dts/iesy/iesy-imx8mm-eva-mi-v1.dts
index 9c99a737439e..5c5d71af225b 100644
--- a/arch/arm64/boot/dts/iesy/iesy-imx8mm-eva-mi-v1.dts
+++ b/arch/arm64/boot/dts/iesy/iesy-imx8mm-eva-mi-v1.dts
@@ -237,6 +237,7 @@ max9867: audio_codec@18 {
 		#sound-dai-cells = <0>;
 		compatible = "maxim,max9867";
 		reg = <0x18>;
+		clocks = <&clk IMX8MM_CLK_SAI5_ROOT>;
 	};
 
 	lontium_lt8912b@48 {
@@ -319,6 +320,7 @@ &sai5 {
 	assigned-clocks = <&clk IMX8MM_CLK_SAI5>;
 	assigned-clock-parents = <&clk IMX8MM_AUDIO_PLL1_OUT>;
 	assigned-clock-rates = <24576000>;
+	fsl,sai-mclk-direction-output;
 };
 
 &iomuxc {
