From 31794bcf680a1a608df8cd478eee63ef5720735a Mon Sep 17 00:00:00 2001
From: Dominik Poggel <pog@iesy.com>
Date: Wed, 5 Feb 2025 12:19:54 +0100
Subject: [PATCH 28/28] arm64: dts: ti: iesy-am62x: add Uart B

Signed-off-by: Dominik Poggel <pog@iesy.com>
---
 arch/arm64/boot/dts/ti/iesy-am62xx-osm-lf.dtsi | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/ti/iesy-am62xx-osm-lf.dtsi b/arch/arm64/boot/dts/ti/iesy-am62xx-osm-lf.dtsi
index 00f9f99e3a90..3f475976dec6 100644
--- a/arch/arm64/boot/dts/ti/iesy-am62xx-osm-lf.dtsi
+++ b/arch/arm64/boot/dts/ti/iesy-am62xx-osm-lf.dtsi
@@ -510,6 +510,15 @@ AM62X_MCU_IOPAD(0x0000, PIN_OUTPUT, 0) /* (E8) MCU_SPI0_CS0 */
 		>;
 	};
 
+	uartb_pins_default: uartb-default-pins {
+		pinctrl-single,pins = <
+			AM62X_MCU_IOPAD(0x001c, PIN_INPUT, 0) /* (A6) MCU_UART0_CTSn */
+			AM62X_MCU_IOPAD(0x0020, PIN_OUTPUT, 0) /* (B6) MCU_UART0_RTSn */
+			AM62X_MCU_IOPAD(0x0014, PIN_INPUT, 0) /* (B5) MCU_UART0_RXD */
+			AM62X_MCU_IOPAD(0x0018, PIN_OUTPUT, 0) /* (A5) MCU_UART0_TXD */
+		>;
+	};
+
 	uartc_pins_default: uartc-default-pins {
 		pinctrl-single,pins = <
 			AM62X_MCU_IOPAD(0x0024, PIN_INPUT, 0) /* (B4) WKUP_UART0_RXD */
@@ -540,6 +549,12 @@ &mcu_spi0 {
 	ti,pindir-d0-out-d1-in;
 };
 
+&mcu_uart0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uartb_pins_default>;
+};
+
 &sdhci0 {
 	status = "okay";
 	pinctrl-names = "default";
-- 
2.30.2

