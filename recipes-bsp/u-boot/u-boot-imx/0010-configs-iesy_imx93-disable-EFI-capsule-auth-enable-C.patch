 configs/iesy_imx93_eva_mi_defconfig | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/configs/iesy_imx93_eva_mi_defconfig b/configs/iesy_imx93_eva_mi_defconfig
